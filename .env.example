# PostgreSQL
POSTGRES_USER=emc_user
POSTGRES_PASSWORD=cambiar_esta_contraseña
POSTGRES_DB=emc_producciones
DATABASE_URL=postgresql://emc_user:cambiar_esta_contraseña@db:5432/emc_producciones

# FastAPI
JWT_SECRET=cambiar_por_una_clave_larga_y_segura
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Router de IA gratuito (orden: gemini -> groq -> openrouter -> deepseek)
# Cada proveedor es opcional; se usa el primero disponible y se salta al
# siguiente cuando agota su cuota. Sin ninguna key, el chat usa la FAQ local.
IA_GEMINI_KEY=your_google_api_key_here
IA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
IA_GEMINI_MODEL=gemini-2.5-flash
IA_GROQ_KEY=your_groq_api_key_here
IA_GROQ_BASE_URL=https://api.groq.com/openai/v1
IA_GROQ_MODEL=llama-3.3-70b-versatile
IA_OPENROUTER_KEY=your_openrouter_api_key_here
IA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
IA_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# DeepSeek (opcional, al final de la cadena del router)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# n8n (integración backend ↔ n8n, ver docs/13-integracion-n8n.md)
# URL del webhook de n8n que recibe las comunicaciones desde FastAPI
# (si n8n esta en tu PC, usa la URL de Cloudflare Tunnel - ver GUIA-DESPLIEGUE.md)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/comunicaciones
# Secreto compartido para los webhooks de n8n → backend (X-Webhook-Secret)
WEBHOOK_SECRET=

# Servicio n8n (docker compose --profile tools)
N8N_USER=admin
N8N_PASSWORD=cambiar_esta_contraseña
N8N_HOST=localhost

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Origenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:4321,https://www.expoinmobiliariayconstruccion.com

# Publicidad / medición (opcionales — quick wins de marketing)
# Meta Pixel ID (formato: 1234567890123456). Vacío = sin píxel.
PUBLIC_META_PIXEL_ID=
# Google Ads / GA4 (formato: G-XXXXXXX o AW-XXXXXXXXX). Vacío = sin tag.
PUBLIC_GTAG_ID=
