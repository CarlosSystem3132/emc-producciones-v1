<section class="contact" id="contacto">
  <div class="wrap">
    <span class="section-tag">Contacto</span>
    <h2 style="font-size: 2.2rem; margin-bottom: 40px">
      Construimos el futuro…
    </h2>

    <div class="contact-grid">
      <div>
        <div
          class="footer-brand"
          style="
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 14px;
          "
        >
          <img
            src="/assets/expoinco-logo.jpg"
            alt="EXPOINCO Logo"
            style="
              width: 52px;
              height: 52px;
              border-radius: 8px;
              object-fit: cover;
              border: 2px solid var(--yellow);
              box-shadow: 0 0 14px rgba(250, 184, 0, 0.4);
            "
          />
          <div>
            <div
              style="
                font-family: Anton, sans-serif;
                font-size: 1.5rem;
                color: var(--paper);
                line-height: 1;
                letter-spacing: 0.02em;
              "
            >
              EXPO<span style="color: var(--yellow)">INCO</span>
            </div>
            <div
              style='
                font-family: "JetBrains Mono", monospace;
                font-size: 0.65rem;
                color: var(--yellow);
                letter-spacing: 0.12em;
                text-transform: uppercase;
                margin-top: 4px;
              '
            >
              Edición Internacional 2027
            </div>
          </div>
        </div>

        <h4>Contáctanos</h4>
        <div class="contact-line">
          <a href="tel:+59168166068" class="contact-link">68166068</a> -
          <a href="tel:+59165312877" class="contact-link">65312877</a>
        </div>
        <div class="contact-line">
          <a href="tel:+59122101468" class="contact-link">2-2101468</a>
        </div>
        <div class="contact-line">
          <a href="tel:+59172890933" class="contact-link">72890933</a> (Cochabamba)
        </div>
        <div class="contact-line">
          <a
            href="mailto:expoinmobiliariayconstruccion@gmail.com?subject=Consulta%20EXPOINCO%202027"
            class="contact-link contact-email"
            title="Enviar correo a EXPOINCO"
