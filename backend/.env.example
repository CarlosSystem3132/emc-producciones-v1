# Copia este archivo como .env y ajusta los valores.
# PostgreSQL
DATABASE_URL=postgresql+psycopg://emc_user:cambiar_esta_contraseña@localhost:5432/emc_producciones

# JWT
JWT_SECRET=cambiar_por_una_clave_larga_y_segura
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# DeepSeek — chat flotante con IA supervisada (opcional; sin key usa FAQ local)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Usuario administrador inicial (se crea solo si no existe ningún admin)
SEED_ADMIN_EMAIL=admin@emcproducciones.com
SEED_ADMIN_PASSWORD=Admin123*
