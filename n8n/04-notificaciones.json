{
  "name": "04 Notificaciones al equipo",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "notificaciones",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "notif-webhook",
      "name": "Webhook notificaciones",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "notificaciones"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.canal }}",
              "rightValue": "whatsapp",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "notif-if",
      "name": "¿Canal WhatsApp?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_ID }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.para, type: 'text', text: { body: $json.mensaje } }) }}",
        "options": {}
      },
      "id": "notif-whatsapp",
      "name": "Enviar WhatsApp al ejecutivo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        420
      ],
      "notes": "Usa WhatsApp Cloud API. Configura WHATSAPP_PHONE_ID en el entorno de n8n."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ raw: $json.mensaje, to: $json.para }) }}",
        "options": {}
      },
      "id": "notif-email",
      "name": "Enviar correo al ejecutivo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        200
      ],
      "notes": "Adaptar el body 'raw' al formato MIME base64 que exige Gmail API."
    }
  ],
  "connections": {
    "Webhook notificaciones": {
      "main": [
        [
          {
            "node": "¿Canal WhatsApp?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Canal WhatsApp?": {
      "main": [
        [
          {
            "node": "Enviar WhatsApp al ejecutivo",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Enviar correo al ejecutivo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}