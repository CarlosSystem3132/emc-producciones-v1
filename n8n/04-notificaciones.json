{
  "name": "04 Notificaciones al equipo",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "notificaciones",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "notif-webhook",
      "name": "Webhook notificaciones",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "notificaciones"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.canal }}",
              "rightValue": "whatsapp",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "notif-if",
      "name": "¿Canal WhatsApp?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_ID }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.para, type: 'text', text: { body: $json.mensaje } }) }}",
        "options": {}
      },
      "id": "notif-whatsapp",
      "name": "Enviar WhatsApp al ejecutivo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        420
      ],
      "notes": "Usa WhatsApp Cloud API. Configura WHATSAPP_PHONE_ID en el entorno de n8n."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ raw: $json.raw }) }}",
        "options": {}
      },
      "id": "notif-email",
      "name": "Enviar correo al ejecutivo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        200
      ],
      "notes": "Adaptar el body 'raw' al formato MIME base64 que exige Gmail API."
    },
    {
      "parameters": {
        "jsCode": "const subject = \"Notificaci\\u00f3n EMC \\u2014 EXPOINCO 2027\";\nreturn $input.all().map((item) => {\n  const d = item.json || {};\n  const to = d.email || '';\n  const body = d.contenido ?? d.mensaje ?? '';\n  const b64 = (s) => Buffer.from(s, 'utf-8').toString('base64');\n  const mime =\n    'MIME-Version: 1.0\\r\\n' +\n    'Content-Type: text/plain; charset=\"UTF-8\"\\r\\n' +\n    'Content-Transfer-Encoding: 8bit\\r\\n' +\n    'To: ' + to + '\\r\\n' +\n    'Subject: =?UTF-8?B?' + b64(subject) + '?=\\r\\n' +\n    '\\r\\n' + body;\n  const raw = b64(mime).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\n  return { json: { ...d, raw } };\n});\n"
      },
      "id": "prep-email-04",
      "name": "Preparar correo MIME",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        200
      ]
    }
  ],
  "connections": {
    "Webhook notificaciones": {
      "main": [
        [
          {
            "node": "¿Canal WhatsApp?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Canal WhatsApp?": {
      "main": [
        [
          {
            "node": "Enviar WhatsApp al ejecutivo",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Preparar correo MIME",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar correo MIME": {
      "main": [
        [
          {
            "node": "Enviar correo al ejecutivo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}