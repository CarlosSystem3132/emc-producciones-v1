{
  "name": "EMC — Liberación automática de reservas expiradas",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 5 }]
        }
      },
      "id": "cron-liberacion",
      "name": "Cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_URL || 'http://api:8000' }}/api/v1/reservas/liberar-expiradas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "liberar-expiradas",
      "name": "Liberar expirados en la API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "notes": "Usa Header Auth: Authorization = Bearer <token admin>. Alternativa: autenticar con usuario/contraseña contra /auth/login."
    }
  ],
  "connections": {
    "Cada 5 minutos": {
      "main": [[{ "node": "Liberar expirados en la API", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
